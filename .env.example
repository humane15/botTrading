# Salin file ini menjadi .env lalu isi sesuai kebutuhan:
#   cp .env.example .env
# File .env TIDAK BOLEH di-commit (sudah ada di .gitignore).

# ============================================================
# Mode trading
# ============================================================
# paper (default): harga live, saldo virtual.
# live: uang sungguhan. Selain TRADING_MODE=live, bot juga wajib
# dijalankan dengan flag --confirm-live.
TRADING_MODE=paper

# ============================================================
# API key Binance
# ============================================================
# Buat API key dengan izin "Enable Reading" dan "Enable Spot & Margin
# Trading" SAJA. JANGAN aktifkan "Enable Withdrawals".
# Wajib aktifkan "Restrict access to trusted IPs only" (IP whitelist).
# Mode paper bisa berjalan tanpa API key (hanya data publik).
BINANCE_API_KEY=
BINANCE_API_SECRET=
# true = pakai Binance Spot Testnet (testnet.binance.vision)
BINANCE_TESTNET=false
REQUEST_TIMEOUT_MS=15000

# ============================================================
# Rate limit dan retry
# ============================================================
MAX_CONCURRENT_REQUESTS=5
MAX_RETRIES=5
RETRY_BASE_DELAY=1.0
RETRY_MAX_DELAY=60

# ============================================================
# Universe coin (dipilih dinamis, diperbarui tiap 24 jam)
# ============================================================
QUOTE_ASSET=USDT
UNIVERSE_SIZE=75
MIN_QUOTE_VOLUME_USD=5000000
UNIVERSE_REFRESH_HOURS=24
# Daftar simbol yang tidak boleh ditradingkan, pisahkan dengan koma.
# Contoh: EXCLUDED_SYMBOLS=LUNC/USDT,USTC
EXCLUDED_SYMBOLS=
# Tag Binance yang dikecualikan (contoh: Monitoring,Seed)
EXCLUDED_TAGS=Monitoring

# ============================================================
# Data candle
# ============================================================
TIMEFRAMES=5m,15m,30m,1h
# Maksimal candle tertutup yang disimpan per timeframe. 1000 (batas satu
# request Binance) membuat EMA 200 hampir identik dengan backtest.
OHLCV_LIMIT=1000
# Jeda setelah candle tutup sebelum candle dianggap final (milidetik)
CANDLE_CLOSE_GRACE_MS=2000

# ============================================================
# Sinyal confluence (Fase 2)
# ============================================================
# Skor minimal (0..100) agar sinyal dianggap layak entry
MIN_SIGNAL_SCORE=65
# Minimal timeframe yang searah (bullish) dari 4 timeframe
MIN_ALIGNED_TIMEFRAMES=3
# Tolak entry jika jarak ke resistance < MIN_REWARD_RISK x jarak ke stop loss
MIN_REWARD_RISK=1.5
# Circuit breaker: jika BTC turun 3% atau lebih dalam 1 jam, entry baru dihentikan selama 2 jam
CIRCUIT_BREAKER_DROP=0.03
CIRCUIT_BREAKER_HOURS=2

# ============================================================
# Manajemen risiko (dipakai mulai Fase 3)
# ============================================================
# Risiko per trade, maksimal 0.02 (2% modal). Rekomendasi 0.01 sampai 0.02.
RISK_PER_TRADE=0.01
MAX_OPEN_POSITIONS=5
DAILY_LOSS_LIMIT=0.05
WEEKLY_LOSS_LIMIT=0.10
# Fee Binance spot 0.1% per sisi, slippage asumsi 0.05%
FEE_RATE=0.001
SLIPPAGE_RATE=0.0005
PAPER_START_BALANCE=100

# ============================================================
# Notifikasi Telegram (opsional)
# ============================================================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ============================================================
# Lokasi file dan logging
# ============================================================
# Kosongkan untuk memakai folder data/ dan logs/ di root proyek
DATA_DIR=
LOGS_DIR=
LOG_LEVEL=INFO
